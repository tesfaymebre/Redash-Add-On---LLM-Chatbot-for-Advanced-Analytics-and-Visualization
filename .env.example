# Copy to .env and fill in values — never commit .env

# OpenAI (Task 4+)
OPENAI_API_KEY=

# Database (Task 2+)
# Docker compose maps host 5433 → container 5432 (see Makefile POSTGRES_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/youtube_analytics

# Redash integration (Task 3+)
REDASH_URL=http://localhost:5000
REDASH_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
CHATBOT_BACKEND_URL=http://localhost:8000
